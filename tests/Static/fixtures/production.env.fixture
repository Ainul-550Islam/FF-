# F-001 accept-half fixture: the complete production environment from
# tests/Feature/Hosting/ProductionHostingTest.php::$env, transcribed
# 2026-10-07. NON-SECRET placeholder values shaped like real ones.
# The PHP test randomizes APP_KEY per run; this pinned copy uses a fixed
# valid-shaped value. Fidelity is pinned by
# tests/Static/test_production_fixture_floor.py -- edit both together.
APP_NAME="FF Arena"
APP_ENV=production
APP_KEY=base64:0Tf+g1SkvtPtfeusgvnidkg3rBNsTT21H2jriNGiIeg=
APP_DEBUG=false
APP_URL=https://ffarena.example
APP_TIMEZONE=Asia/Dhaka
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=10.0.0.10
DB_PORT=5432
DB_DATABASE=ffarena
DB_USERNAME=ffarena_app
DB_PASSWORD=fixture-not-a-real-password
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
