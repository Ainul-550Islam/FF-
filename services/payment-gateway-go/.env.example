# Go Payment Gateway - Production Hardening .env.example
# All secrets use obvious placeholders - never real production credentials
# No real secret may remain committed to source control

# Service
PORT=8081
APP_ENV=sandbox
SERVICE_ID=payment-gateway-go
VERSION=1.0.0
LOG_LEVEL=info
ENABLE_METRICS=true

# Payment Environment - must be one of development, testing, sandbox, staging, production
PAYMENT_ENV=sandbox

# Database - PostgreSQL primary + replica for read scaling
# Primary
DATABASE_URL=postgres://ffarena:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ffarena?sslmode=disable
DB_DRIVER=postgres
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=5
DB_CONN_MAX_IDLE_TIME_MIN=1

# Replica for read scaling - optional but recommended for production
DATABASE_REPLICA_URL=postgres://ffarena:CHANGE_ME_POSTGRES_PASSWORD@postgres-replica:5432/ffarena?sslmode=disable
DB_REPLICA_MAX_OPEN_CONNS=30
DB_REPLICA_MAX_IDLE_CONNS=10
USE_REPLICA=false

# Redis - for distributed token cache, bulkhead, rate limiting
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# Secrets - MUST be at least 32 characters, reject weak strings
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS_PLACEHOLDER_1234567890
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET_MIN_32_CHARS_PLACEHOLDER_123456
SERVICE_HMAC_SECRET=CHANGE_ME_HMAC_SECRET_MIN_32_CHARS_PLACEHOLDER_12345678
TOKEN_ENCRYPTION_KEY=CHANGE_ME_TOKEN_ENCRYPTION_KEY_32_BYTES_EXACT!

# Rate limiting
RATE_LIMIT_PER_MIN=60

# CORS - strict domain whitelisting, no * in production
# Default: https://ffarena.com,https://www.ffarena.com,https://api.ffarena.com,https://payment.ffarena.com
# Supports wildcard: https://*.ffarena.com
CORS_ALLOWED_ORIGINS=https://ffarena.com,https://www.ffarena.com,https://api.ffarena.com,https://payment.ffarena.com

# Observability - Jaeger/OTEL tracing
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
OTEL_EXPORTER_JAEGER_ENDPOINT=http://jaeger:14268/api/traces
OTEL_SERVICE_NAME=payment-gateway-go

# bKash - Tokenized Checkout Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
# Production: https://tokenized.pay.bka.sh/v1.2.0-beta/tokenized/checkout
# Never hardcode production credentials
PAYMENT_BKASH_ENABLED=false
PAYMENT_BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
PAYMENT_BKASH_APP_KEY=CHANGE_ME_BKASH_APP_KEY_PLACEHOLDER
PAYMENT_BKASH_APP_SECRET=CHANGE_ME_BKASH_APP_SECRET_PLACEHOLDER
PAYMENT_BKASH_USERNAME=CHANGE_ME_BKASH_USERNAME_PLACEHOLDER
PAYMENT_BKASH_PASSWORD=CHANGE_ME_BKASH_PASSWORD_PLACEHOLDER
PAYMENT_BKASH_SECRET=CHANGE_ME_BKASH_SECRET_PLACEHOLDER
PAYMENT_BKASH_CALLBACK_URL=https://api.ffarena.com/api/v1/webhooks/inbound/bkash
PAYMENT_BKASH_TIMEOUT=15000

# Legacy bKash vars for backward compat
BKASH_TOKENIZE_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_TOKENIZE_APP_KEY=CHANGE_ME_BKASH_APP_KEY_PLACEHOLDER
BKASH_TOKENIZE_APP_SECRET=CHANGE_ME_BKASH_APP_SECRET_PLACEHOLDER
BKASH_TOKENIZE_USER_NAME=CHANGE_ME_BKASH_USERNAME_PLACEHOLDER
BKASH_TOKENIZE_PASSWORD=CHANGE_ME_BKASH_PASSWORD_PLACEHOLDER
BKASH_CALLBACK_URL=https://api.ffarena.com/api/v1/webhooks/inbound/bkash
BKASH_TOKENIZE_SANDBOX=true

# Nagad - Sandbox: http://sandbox.mynagad.com:10060, Production: https://api.mynagad.com
PAYMENT_NAGAD_ENABLED=false
PAYMENT_NAGAD_BASE_URL=http://sandbox.mynagad.com:10060
PAYMENT_NAGAD_MERCHANT_ID=CHANGE_ME_NAGAD_MERCHANT_ID_PLACEHOLDER
PAYMENT_NAGAD_MERCHANT_NUMBER=CHANGE_ME_NAGAD_MERCHANT_NUMBER_PLACEHOLDER
PAYMENT_NAGAD_PRIVATE_KEY=CHANGE_ME_NAGAD_PRIVATE_KEY_PLACEHOLDER_PEM_FORMAT
PAYMENT_NAGAD_PUBLIC_KEY=CHANGE_ME_NAGAD_PUBLIC_KEY_PLACEHOLDER_PEM_FORMAT
PAYMENT_NAGAD_SECRET=CHANGE_ME_NAGAD_SECRET_PLACEHOLDER
PAYMENT_NAGAD_CALLBACK_URL=https://api.ffarena.com/api/v1/webhooks/inbound/nagad
PAYMENT_NAGAD_TIMEOUT=20000

# Legacy Nagad vars
NAGAD_BASE_URL=http://sandbox.mynagad.com:10060
NAGAD_MERCHANT_ID=CHANGE_ME_NAGAD_MERCHANT_ID_PLACEHOLDER
NAGAD_MERCHANT_NUMBER=CHANGE_ME_NAGAD_MERCHANT_NUMBER_PLACEHOLDER
NAGAD_PRIVATE_KEY=CHANGE_ME_NAGAD_PRIVATE_KEY_PLACEHOLDER_PEM_FORMAT
NAGAD_PUBLIC_KEY=CHANGE_ME_NAGAD_PUBLIC_KEY_PLACEHOLDER_PEM_FORMAT
NAGAD_CALLBACK_URL=https://api.ffarena.com/api/v1/webhooks/inbound/nagad

# Rocket - No public M2M sandbox, capability detection explicit unsupported
PAYMENT_ROCKET_ENABLED=false
PAYMENT_ROCKET_BASE_URL=
PAYMENT_ROCKET_MERCHANT_ID=CHANGE_ME_ROCKET_MERCHANT_ID_PLACEHOLDER
PAYMENT_ROCKET_SECRET=CHANGE_ME_ROCKET_SECRET_PLACEHOLDER
PAYMENT_ROCKET_TIMEOUT=15000

# Legacy Rocket vars
ROCKET_BASE_URL=
ROCKET_MERCHANT_ID=CHANGE_ME_ROCKET_MERCHANT_ID_PLACEHOLDER

# Manual provider - fallback only when explicitly configured
PAYMENT_MANUAL_ENABLED=true
PAYMENT_MANUAL_SECRET=CHANGE_ME_MANUAL_SECRET_PLACEHOLDER

# Feature flags - must NOT bypass auth idempotency ledger webhook verification audit rate limiting
PAYMENT_PROVIDER_BKASH_ENABLED=false
PAYMENT_PROVIDER_NAGAD_ENABLED=false
PAYMENT_PROVIDER_ROCKET_ENABLED=false

# TLS Certificate Pinning for outbound provider connections
# Base64 encoded SHA256 of SPKI (Subject Public Key Info) for provider certs
# Generate with: openssl s_client -connect tokenized.sandbox.bka.sh:443 | openssl x509 -pubkey | openssl pkey -pubout | openssl pkey -pubout -outform der | openssl dgst -sha256 -binary | base64
BKASH_CERT_PIN=CHANGE_ME_BKASH_CERT_PIN_SHA256_BASE64
NAGAD_CERT_PIN=CHANGE_ME_NAGAD_CERT_PIN_SHA256_BASE64
ROCKET_CERT_PIN=CHANGE_ME_ROCKET_CERT_PIN_SHA256_BASE64

# HSTS preload compliance - must be served over HTTPS with valid cert
# Requirements: max-age >= 31536000, includeSubDomains, preload, redirect HTTP to HTTPS
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
