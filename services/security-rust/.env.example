# Rust Security Service - Production Hardening .env.example
# All secrets use obvious placeholders - never real production credentials
# No real secret may remain committed to source control

# Service
PORT=8082
APP_ENV=sandbox
SERVICE_ID=security-rust
VERSION=1.0.0
LOG_LEVEL=info

# Database - PostgreSQL
DATABASE_URL=postgres://ffarena:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ffarena?sslmode=disable
DB_DRIVER=postgres

# Redis - for distributed rate limiting, token cache, bulkhead
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1

# Secrets - MUST be at least 32 characters, reject weak strings
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS_PLACEHOLDER_1234567890
SERVICE_HMAC_SECRET=CHANGE_ME_HMAC_SECRET_MIN_32_CHARS_PLACEHOLDER_12345678
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET_MIN_32_CHARS_PLACEHOLDER_123456
TOKEN_ENCRYPTION_KEY=CHANGE_ME_TOKEN_ENCRYPTION_KEY_32_BYTES_EXACT!

# Rate limiting
RATE_LIMIT_PER_MIN=60

# CORS - strict domain whitelisting
CORS_ALLOWED_ORIGINS=https://ffarena.com,https://www.ffarena.com,https://api.ffarena.com,https://admin.ffarena.com

# Observability - Jaeger/OTEL tracing
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
OTEL_EXPORTER_JAEGER_ENDPOINT=http://jaeger:14268/api/traces
OTEL_SERVICE_NAME=security-rust

# Security Headers - HSTS preload compliance
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# JWT Configuration
JWT_EXPIRY_SECONDS=3600
JWT_ISSUER=ffarena
JWT_AUDIENCE=ffarena-services

# HMAC Configuration
HMAC_ALGORITHM=SHA256
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# Fraud Detection
FRAUD_ENABLED=true
FRAUD_THRESHOLD_LOW=30
FRAUD_THRESHOLD_MEDIUM=60
FRAUD_THRESHOLD_HIGH=80

# Device Fingerprinting
DEVICE_FINGERPRINT_ENABLED=true
DEVICE_FINGERPRINT_SALT=CHANGE_ME_DEVICE_FINGERPRINT_SALT_32_CHARS!

# IP Geolocation
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_API_KEY=CHANGE_ME_IP_GEOLOCATION_API_KEY_PLACEHOLDER

# Anti-Cheat
ANTI_CHEAT_ENABLED=true

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_LOG_REDACTION=true

# TLS Certificate Pinning for outbound connections
# Base64 encoded SHA256 of SPKI for external services
EXTERNAL_API_CERT_PINS=CHANGE_ME_EXTERNAL_API_CERT_PINS_PLACEHOLDER

# Security - Secret strength validation
# Minimum 32 characters, reject weak strings: secret, password, 123456, test, default, changeme, admin, letmein, qwerty, abc123, etc
# Reject sequential characters (e.g., 123456, abcdef) and low entropy (repeated chars)
SECRET_MIN_LENGTH=32
SECRET_REJECT_WEAK=true
SECRET_REJECT_SEQUENTIAL=true
SECRET_REJECT_LOW_ENTROPY=true
