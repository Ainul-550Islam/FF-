<?xml version="1.0" encoding="UTF-8"?>
<!--
    G1 — PostgreSQL test matrix + R9 Real PostgreSQL Integration
    Identical to phpunit.xml except the database runs on PostgreSQL so the
    full suite is exercised against the production driver.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- R9 lives inside tests/Feature and is picked up above; listing it
             twice makes PHPUnit emit "already added to test suite" warnings. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:bgN0yS08tC5r/rDRWdX8EeqxrkOIJezGxtmpEqXSGhI="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The dialect this profile proves. `force="true"` on <env> is not
             enough: PHPUnit writes $_ENV and putenv(), and Laravel's env()
             reads $_SERVER first, which PHP fills from the process environment
             at startup. The <server> entry is what actually pins it, so a
             leaked DB_CONNECTION cannot turn this profile into a different
             database reporting a green run. FFARENA_TEST_PROFILE lets the
             suite assert, from inside, that the pin held
             (tests/Feature/ProfilePinningTest.php). -->
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="FFARENA_TEST_PROFILE" value="pgsql"/>
        <env name="FFARENA_TEST_PROFILE" value="pgsql" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="false"/>
        <env name="DB_PORT" value="5432" force="false"/>
        <env name="DB_DATABASE" value="ffarena_test" force="false"/>
        <env name="DB_USERNAME" value="ffarena" force="false"/>
        <env name="DB_PASSWORD" value="ffarena" force="false"/>
        <env name="DB_URL" value="" force="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- GAP-10 A7 — pin every notification / push flag the suite depends on,
             with force="true" so the developer's .env can never change a test
             outcome. Keep these in sync with config/notifications.php,
             config/features.php (notification_*, mobile_push) and
             config/mobile.php (PUSH_*). -->
        <env name="NOTIFICATIONS_EMAIL" value="true" force="true"/>
        <env name="FEATURE_NOTIFICATION_EMAIL" value="true" force="true"/>
        <env name="FEATURE_NOTIFICATION_PUSH" value="true" force="true"/>
        <env name="FEATURE_NOTIFICATION_SMS" value="false" force="true"/>
        <env name="FEATURE_MOBILE_PUSH" value="true" force="true"/>
        <env name="PUSH_FCM_ENABLED" value="false" force="true"/>
        <env name="PUSH_APNS_ENABLED" value="false" force="true"/>

        <!-- GAP-10 A1/A3 — the numbered simulation families (gameberry/core,
             gameberry/final*, gameberry/stats) are registered in the test
             environment so their guards can be exercised. Production stays
             fail-closed: the flag is ignored outside local/testing. -->
        <env name="GAMEBERRY_NUMBERED_SIMULATIONS" value="true" force="true"/>

    </php>
</phpunit>
