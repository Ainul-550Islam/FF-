# FF Arena — production application runtime environment template.
#
# Copy to the deployment environment file (NOT into version control), fill in
# every REQUIRED value, then run the gate before starting the app:
#
#   python3 deploy/validate-env.py --env-file /etc/ffarena/app.env --production
#
# The gate exits non-zero on anything that would make the deployment unsafe or
# half-configured, so it can run in CI, in the container entrypoint, or in a
# deploy script. Every key below exists in config/ — this file does not invent
# settings, and it never contains real credentials.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="FF Arena"
APP_ENV=production                 # REQUIRED: production (any other value disables the production gates)
APP_KEY=                           # REQUIRED: php artisan key:generate --show
APP_DEBUG=false                    # REQUIRED: must be false in production
APP_URL=https://arena.example.com  # REQUIRED: the real HTTPS origin (no placeholder)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Trusted proxies: only the reverse proxy in front of the app may set
# X-Forwarded-*; leave empty when the app is directly exposed.
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADERS=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ffarena
DB_USERNAME=ffarena
DB_PASSWORD=                       # REQUIRED: injected from the secret manager
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# Cache, session, queue
# ---------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                    # REQUIRED: injected from the secret manager
REDIS_PREFIX=ffarena-
CACHE_PREFIX=ffarena-cache-

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@arena.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Payments — provider credentials are per-provider secrets, never shared.
# An empty provider secret means "fall back to PAYMENT_WEBHOOK_SECRET".
# ---------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=            # REQUIRED: long random value, never CHANGE_ME
PAYMENT_CALLBACK_SECRET=
WEBHOOK_BKASH_SECRET=
WEBHOOK_NAGAD_SECRET=
WEBHOOK_ROCKET_SECRET=
WEBHOOK_SSLCOMMERZ_SECRET=
WEBHOOK_CARD_SECRET=

# Maker-checker: payouts at or above this amount require a second admin.
# 0 = every queue-approved payout, -1 would disable (not accepted here: the
# validator refuses a disabled control in production).
PAYOUT_DUAL_CONTROL_THRESHOLD_MINOR=0

# ---------------------------------------------------------------------------
# Security headers / CSP  (GAP-10 A6)
# ---------------------------------------------------------------------------
# Rollout order: start REPORT-ONLY, collect violations, then enforce.
#   1) SECURITY_CSP_ENABLE=true,  SECURITY_CSP_REPORT_ONLY=true
#   2) read the reports, fix inline sources, then set
#      SECURITY_CSP_REPORT_ONLY=false to start blocking.
# deploy/validate-env.py fails a production deployment where CSP is neither
# enforced nor report-only, because that means no policy is applied at all.
SECURITY_CSP_ENABLE=true
SECURITY_CSP_REPORT_ONLY=true
SECURITY_CSP_POLICY=""
SECURITY_CSP_REPORT_URI=           # optional collector endpoint for violations
SECURITY_HSTS_ENABLE=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
CORS_ALLOWED_ORIGINS=              # comma-separated exact origins; never "*"

# ---------------------------------------------------------------------------
# Backups  (GAP-10 C)
# ---------------------------------------------------------------------------
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION=30
BACKUP_INCLUDE_PRIVATE_FILES=true
BACKUP_INTEGRITY_CHECK=true
BACKUP_NOTIFY_ADMINS=true

# At-rest encryption: age recipient (public key). REQUIRED in production — the
# matching private key lives in escrow, never on the web host.
BACKUP_ENCRYPTION_RECIPIENT=

# Offsite copy. Set BACKUP_OFFSITE_REQUIRED=true in production so a missing or
# unreachable target fails the backup instead of silently staying local-only.
BACKUP_OFFSITE_REQUIRED=true
BACKUP_OFFSITE_DISK=backup-offsite
BACKUP_OFFSITE_BUCKET=             # REQUIRED when the disk above is set
BACKUP_OFFSITE_REGION=
BACKUP_OFFSITE_ENDPOINT=           # set for R2/MinIO/B2; empty for AWS S3
BACKUP_OFFSITE_KEY=
BACKUP_OFFSITE_SECRET=
BACKUP_OFFSITE_ROOT=
BACKUP_OFFSITE_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Point-in-time recovery (PostgreSQL, see deploy/postgres-init.sh)
# ---------------------------------------------------------------------------
# Enabling this requires the postgres service to mount a WAL archive volume.
WAL_ARCHIVE_ENABLED=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
REQUEST_ID_HEADER=X-Request-ID
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# 'log' (structured lines) or 'prometheus' (scrapable /metrics series).
METRICS_DRIVER=prometheus
METRICS_LOG_CHANNEL=metrics
FEATURE_PROMETHEUS=true
METRICS_SCRAPE_TOKEN=              # REQUIRED when FEATURE_PROMETHEUS=true

ERROR_REPORTING_DRIVER=log
SENTRY_DSN=

HEALTH_WORKER_STALE_SECONDS=300
HEALTH_SCHEDULER_STALE_SECONDS=300

OBS_RETENTION_OTP_DAYS=1
OBS_RETENTION_IDEMPOTENCY_DAYS=2
OBS_RETENTION_NOTIFICATIONS_DAYS=180
OBS_RETENTION_WEBHOOK_DELIVERIES_DAYS=30
OBS_RETENTION_WEBHOOK_EVENTS_DAYS=90
OBS_RETENTION_LIVE_EVENTS_DAYS=30
OBS_RETENTION_FAILED_JOBS_DAYS=30

# ---------------------------------------------------------------------------
# Development-only simulation families
# ---------------------------------------------------------------------------
# The numbered Gameberry simulation families (gameberry/core, gameberry/final*,
# gameberry/stats) are development scaffolding. Production is fail-closed
# regardless of this value; keep it false so the intent is explicit.
GAMEBERRY_NUMBERED_SIMULATIONS=false

# ---------------------------------------------------------------------------
# Mobile / push (honest capability flags — leave off until credentials exist)
# ---------------------------------------------------------------------------
PUSH_FCM_ENABLED=false
PUSH_APNS_ENABLED=false
